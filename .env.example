# =====================================================================
# ENVIRONTMENT VARIABLES (VERCEL / LOCAL)
# =====================================================================
# CATATAN PENTING:
# Aplikasi ini 100% SIAP JALAN TANPA ENVIRONTMENT VARIABLE (Rp 0).
# Jika variabel di bawah TIDAK diisi, aplikasi otomatis menggunakan
# LocalStorage + BroadcastChannel API (tersimpan di HP Anda & sinkron antar-tab).
#
# JIKA INGIN SINKRONISASI MULTI-DEVICE (ANTAR HP / CLOUD SUPABASE):
# Masukkan 2 variabel di bawah ini di menu Vercel: Project Settings -> Environment Variables
# =====================================================================

# URL Proyek Supabase (Opsional - Multi-device Cloud Sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public API Key Supabase (Opsional - Multi-device Cloud Sync)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
